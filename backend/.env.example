# ---------------------------------------------------------------------------
# BloodLink environment configuration.
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# ---- Database (MySQL) ------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bloodlink
DB_USER=bloodlink_user
DB_PASSWORD=change_me

# Alternative: set the full SQLAlchemy URL directly (overrides the pieces above)
# DATABASE_URL=mysql+pymysql://bloodlink_user:change_me@localhost:3306/bloodlink

# ---- Auth / JWT -------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- OTP service (architecture is ready; plug in a real SMS provider) ------
OTP_PROVIDER=console        # console | twilio | msg91 (extend otp_service.py)
OTP_EXPIRE_SECONDS=300
OTP_LENGTH=6
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Maps --------------------------------------------------------------------
# Works with either provider. Leaving MAP_PROVIDER=osm needs no key.
MAP_PROVIDER=osm            # osm | google
GOOGLE_MAPS_API_KEY=

# ---- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# ---- ML ------------------------------------------------------------------
ML_MODEL_PATH=app/ml/model.pkl
